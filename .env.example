# Next.js dashboard / Vercel environment
# Copy this file to .env.local for local development. Vercel uses the same
# name in Project Settings -> Environment Variables.
# This is the only deployment variable required by the application.
# It may point to Neon, Supabase Postgres, Railway, Render, a transaction
# pooler, self-hosted PostgreSQL, or any compatible PostgreSQL provider.
# The panel uses node-postgres directly; Prisma is not required.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=disable
# The panel enforces pg ssl:false for transaction-pooler compatibility.

# R2 credentials, bucket, orchestrator URL, worker secret, and orchestrator
# secret are entered in Dashboard > Settings and synchronized in PostgreSQL.
# They are intentionally not environment variables and are never sent to
# processors.
