# Cloudflare Worker local/deployment configuration.
# Workers Builds settings:
#   Worker name: video-compressor-panel
#   Root directory: workers/backend-orchestrator
#   Build command: leave blank (Wrangler bundles src/index.ts)
#   Deploy command: pnpm run deploy
# Workers Builds reads PANEL_URL and ORCHESTRATOR_SECRET from Build Variables
# and Secrets. The deploy script uploads them as runtime bindings.
# Never commit .dev.vars or real secret values.

# Public Vercel origin. Do not include /api/orchestrator. This is configured
# as a non-secret Worker variable in wrangler.jsonc.
PANEL_URL=https://your-panel.vercel.app

# Must exactly match the orchestrator secret saved in Dashboard > Settings.
ORCHESTRATOR_SECRET=replace-with-a-long-random-secret

# Local-only settings (optional; .dev.vars is loaded by `wrangler dev`).
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
